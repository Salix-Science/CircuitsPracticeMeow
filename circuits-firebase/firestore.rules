rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: logged-in users read all profiles (for admin analytics),
    // write only their own — or admins can write any
    match /users/{userId} {
      allow read:  if request.auth != null;
      allow write: if request.auth.uid == userId || isAdmin();
    }

    // Shared content — any logged-in user can read
    // Only admins can create / update / delete
    match /problems/{id} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }
    match /posts/{id} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }
    match /assignments/{id} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }
    match /folders/{id} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }
    match /topics/{id} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }
    // Homepage config and any future config docs
    match /config/{docId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
  }
}
